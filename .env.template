# ── BitGN Benchmark ─────────────────────────────────────────────────────────
BENCHMARK_HOST=https://api.bitgn.com
BITGN_API_KEY=
BENCHMARK_ID=bitgn/pac1-prod

# ── Run & Eval model  (self-hosted Qwen via LiteLLM) ────────────────────────
# DSPy model string for the agent that runs/evaluates tasks.
# Use the "openai/" prefix for any OpenAI-compatible endpoint.
RUN_MODEL_ID=openai/gpt-5.4

# Base URL of your LiteLLM proxy or vLLM endpoint (no trailing slash)
RUN_MODEL_API_BASE=https://openrouter.ai/api/v1

# API key for the self-hosted endpoint (can be any non-empty string if your
# server doesn't enforce authentication)
RUN_MODEL_API_KEY=

# ── Optimize model  (Anthropic Claude) ──────────────────────────────────────
# Used as the prompt_model in MIPROv2 (generates instruction candidates).
# BootstrapFewShot also uses this as the teacher LM.
OPTIMIZE_MODEL_ID=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Path where an optimized agent state is saved / loaded
OPTIMIZED_AGENT_PATH=optimized_agent.json
